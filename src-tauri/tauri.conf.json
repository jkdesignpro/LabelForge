{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabelForge",
  "version": "0.1.0",
  "identifier": "com.jkdesignpro.labelforge",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "LabelForge", "width": 1360, "height": 860, "minWidth": 980, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Label designer and printing",
    "copyright": "LabelForge contributors, AGPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" }
  }
}
